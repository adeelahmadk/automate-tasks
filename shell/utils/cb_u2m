#!/usr/bin/env bash

#########################################################
# Script:       cb_u2t (clipboard url to md link)       #
# Version:      0.2                                     #
# Author:       Adeel Ahmad (adeelahmadk)               #
# Date Created: May 17, 2026                            #
# Date Mod.:    Jun 16, 2026                            #
# Usage:        cb_u2m                                  #
# Depends:                                              #
#               - wl-clipboard (wayland) or xsel (X11)  #
#               - sed                                   #
# Description:  Extracts title of a blog post from url: #
#                 - takes url from clipboard            #
#                 - pastes markdown link back           #
#               **Best used in a keyboard combo**       #
#########################################################

# Get URL, clean it, and extract title
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
  url=$(wl-paste)
else
  url=$(xsel -ob)
fi

# Clean URL and extract the trailing slug
clean="${url%%[?#]*}"
title="${clean%/}"
title="${title##*/}"

# 1. Replace dashes/underscores with spaces
# 2. Convert everything to lowercase
# 3. Capitalize the first letter of every word
title=$(echo $title | sed -E 's/[-_]/ /g ; s/(.*)/\L\1/ ; s/\b(.)/\u\1/g')

# 4. Fix Prepositions: Convert specific capitalized words to lowercase
title=$(echo "$title" | sed -E 's/\b(In|On|At|To|For|With|And|By)\b/\L&/g')

# 5. Fix Abbreviations: Convert specific words to uppercase
title=$(echo "$title" | sed -E 's/\b(Html|Xml|Xss|Css|Api|Url|Php)\b/\U&/g')

# 6. Ensure the very first word of the title is ALWAYS capitalized
title=$(echo "$title" | sed -E 's/^(.)/\u\1/')

# Format as Markdown link
md_link="[${title}](${url})"

# Copy the result back to clipboard
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
  echo -n "$md_link" | wl-copy
else
  echo -n "$md_link" | xsel -ib
fi
